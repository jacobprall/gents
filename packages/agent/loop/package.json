    "@gents/agent-otel": "workspace:*",
    "@gents/agent-tools": "workspace:*",
    "@opentelemetry/api": "^1.9.0"
  },
  "devDependencies": {
    "bun-types": "latest",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0"
  }
}
